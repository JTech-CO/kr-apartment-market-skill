# Required: 국토교통부 실거래 Open API key
DATA_GO_KR_API_KEY=

# Optional: 청약홈/ODCloud tools
ODCLOUD_API_KEY=
ODCLOUD_SERVICE_KEY=

# Runtime defaults
TZ=Asia/Seoul
KR_APARTMENT_HTTP_TIMEOUT=20
KR_APARTMENT_RETRY_COUNT=3
KR_APARTMENT_PAGE_SIZE=1000
KR_APARTMENT_MAX_PAGES=50
KR_APARTMENT_MAX_MONTHS=60

# Local persistence. Do not commit the generated JSON files.
KR_APARTMENT_WATCHLIST_PATH=.data/watchlist.json
KR_HOME_FINDER_PATH=.data/home_finder.json

# true: expose 32 canonical tools + 16 vendored compatibility tools.
# false: expose only kr_apartment.* and kr_home.* canonical tools.
ENABLE_REAL_ESTATE_MCP_COMPAT=true
